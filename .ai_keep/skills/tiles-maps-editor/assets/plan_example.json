        { "op": "fill", "color": [186, 180, 168] },
        { "op": "dither", "color": [170, 164, 152], "density": 2 },
        { "op": "dither", "color": [200, 195, 184], "density": 4 },
        { "op": "rect", "box": [0, 0, 31, 31], "outline": [150, 145, 134] }
      ]
    },
    {
      "name": "flag_base",
      "desc": "升旗台石台",
      "ops": [
        { "op": "rect", "box": [2, 2, 29, 29], "fill": [168, 178, 186], "outline": "$OUTLINE" },
        { "op": "rect", "box": [5, 5, 26, 26], "fill": [186, 195, 202] },
        { "op": "dither", "color": [170, 180, 188], "density": 3, "box": [5, 5, 26, 26] }
      ]
    },
    {
      "name": "flagpole",
      "desc": "旗杆",
      "ops": [
        { "op": "rect", "box": [14, 2, 16, 29], "fill": [198, 198, 204], "outline": "$OUTLINE" },
