{
  "_comment": "配方示例：程序化生成 32×32 瓦片。copy 改名为自己的配方。ops 按顺序叠画。",
  "palette": "school",
  "mapping": "school_tiles.json",
  "colors": {
    "_comment": "可选：覆盖内置调色板同名字色，如 \"BLACKBOARD\": [46, 62, 48]"
  },
  "tiles": [
    {
      "name": "blackboard",
      "desc": "黑板（带粉笔字）",
      "ops": [
        { "op": "rect", "box": [0, 0, 31, 31], "fill": "$WOOD_D", "outline": "$OUTLINE" },
        { "op": "rect", "box": [1, 1, 30, 30], "fill": [46, 62, 48] },
        { "op": "line", "from": [6, 2], "to": [6, 29], "color": [40, 56, 43] },
        { "op": "line", "from": [14, 2], "to": [14, 29], "color": [40, 56, 43] },
        { "op": "line", "from": [22, 2], "to": [22, 29], "color": [40, 56, 43] },
        { "op": "chalk", "lines": [[4, 9, 16, 9], [4, 14, 22, 14], [4, 19, 13, 19], [20, 19, 26, 19]] }
      ]
    },
    {
      "name": "lectern",
      "desc": "讲台",
      "ops": [
        { "op": "rect", "box": [0, 6, 31, 14], "fill": "$WOOD", "outline": "$OUTLINE" },
        { "op": "rect", "box": [0, 14, 31, 26], "fill": "$WOOD_D" },
        { "op": "line", "from": [0, 14], "to": [31, 14], "color": "$OUTLINE" },
        { "op": "dither", "color": [150, 90, 40], "density": 3, "box": [1, 15, 31, 25] }
      ]
    },
    {
      "name": "desk",
      "desc": "双人课桌",
      "ops": [
        { "op": "rect", "box": [2, 8, 29, 23], "fill": "$WOOD", "outline": "$OUTLINE" },
        { "op": "line", "from": [2, 12], "to": [29, 12], "color": "$WOOD_D" },
        { "op": "dither", "color": [225, 150, 70], "density": 3, "box": [3, 9, 28, 11] },
        { "op": "rect", "box": [4, 24, 7, 29], "fill": "$SLATE_D" },
        { "op": "rect", "box": [24, 24, 27, 29], "fill": "$SLATE_D" }
      ]
    },
    {
      "name": "chair",
      "desc": "椅子",
      "ops": [
        { "op": "rect", "box": [10, 8, 21, 13], "fill": "$WOOD" },
        { "op": "rect", "box": [10, 14, 21, 21], "fill": "$WOOD_D", "outline": "$OUTLINE" },
        { "op": "rect", "box": [11, 22, 13, 27], "fill": "$SLATE_D" },
        { "op": "rect", "box": [18, 22, 20, 27], "fill": "$SLATE_D" }
      ]
    },
    {
      "name": "concrete",
      "desc": "水泥路面",
      "ops": [
        { "op": "fill", "color": "$SLATE_D" },
        { "op": "dither", "color": [95, 90, 95], "density": 2 },
        { "op": "line", "from": [0, 0], "to": [31, 0], "color": [60, 57, 60] },
        { "op": "line", "from": [0, 16], "to": [31, 16], "color": [60, 57, 60] },
        { "op": "line", "from": [16, 0], "to": [16, 15], "color": [60, 57, 60] },
        { "op": "rect", "box": [0, 0, 31, 31], "outline": [50, 47, 50] }
      ]
    },
    {
      "name": "brick_wall",
      "desc": "砖墙立面",
