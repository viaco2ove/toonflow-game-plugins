        { "op": "fence", "rail": "$IRON_D", "bar": "$IRON", "outline": "$OUTLINE", "bars": [4, 13, 22, 28] }
      ]
    },
    {
      "name": "hoop",
      "desc": "篮球架",
      "ops": [
        { "op": "rect", "box": [6, 2, 25, 17], "fill": [226, 222, 210], "outline": "$OUTLINE" },
        { "op": "rect", "box": [11, 6, 20, 13], "outline": [190, 70, 60] },
        { "op": "rect", "box": [15, 0, 17, 3], "fill": [110, 114, 122] }
      ]
    },
    {
      "name": "notice",
      "desc": "校园公告栏",
      "ops": [
        { "op": "rect", "box": [1, 1, 30, 30], "fill": "$WOOD_D", "outline": "$OUTLINE" },
        { "op": "rect", "box": [3, 3, 28, 28], "fill": [96, 78, 56] },
        { "op": "rect", "box": [6, 6, 15, 14], "fill": "$WHITE" },
        { "op": "rect", "box": [17, 6, 26, 14], "fill": [222, 214, 196] },
        { "op": "rect", "box": [6, 17, 26, 25], "fill": [210, 202, 184] }
      ]
    },
    {
      "name": "bench",
      "desc": "长条排椅",
      "ops": [
        { "op": "rect", "box": [1, 10, 30, 17], "fill": "$WOOD", "outline": "$OUTLINE" },
        { "op": "rect", "box": [4, 18, 7, 25], "fill": "$SLATE_D" },
        { "op": "rect", "box": [24, 18, 27, 25], "fill": "$SLATE_D" }
      ]
    }
  ]
}