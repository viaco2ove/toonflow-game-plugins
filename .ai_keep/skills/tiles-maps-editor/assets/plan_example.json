        { "op": "brick", "base": "$BRICK", "mortar": "$MORTAR", "bw": 16, "bh": 8 },
        { "op": "rect", "box": [0, 0, 31, 31], "outline": "$OUTLINE" }
      ]
    },
    {
      "name": "school_floor",
      "desc": "教室水磨石地面",
