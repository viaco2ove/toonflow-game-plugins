{
  "name": "field-survival-vue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "野外生存插件前端（Vue 3），构建产物输出到 ../ui/game.html",
  "scripts": {
    "dev": "vite",
    "debug": "node scripts/debug.cjs",
    "debug:story": "cross-env STORY=赦夜人冥夜走廊-第二季 vite --mode debug",
    "debug:conn": "cross-env STORY=赦夜人冥夜走廊-第二季 CONN=1 vite --mode debug",
    "build": "vite build && node -e \"const fs=require('fs');fs.renameSync('../ui/index.html','../ui/game.html');console.log('renamed to ui/game.html')\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "cross-env": "^10.1.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-singlefile": "^2.0.0"
  }
}
