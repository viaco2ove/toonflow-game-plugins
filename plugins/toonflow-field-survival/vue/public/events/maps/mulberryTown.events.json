      "trigger": { "type": "interact", "uid": "225" },
      "conditions": [
        { "type": "flag_check", "key": "phase_1_active", "value": true },
        { "type": "flag_check", "key": "broom_picked", "value": true }
      ],
      "actions": [
        { "type": "run_script", "script": "E03_xuanchen_bainian" }
      ]
    },
    {
      "id": "E05_open_forest",
      "comment": "phase_1 收尾：拜师后山门牌坊解锁 → 传青云竹海",
      "trigger": { "type": "interact", "uid": "219" },
      "conditions": [
        { "type": "flag_check", "key": "phase_1_done", "value": true }
      ],
      "actions": [
        { "type": "toast", "text": "【收徒系统】山门已开，可前往青云竹海历练。", "color": "gold" },
        { "type": "teleport", "map": "Mulberry Forest", "x": 1, "y": 25 }
      ]
    },
    {
      "id": "E10_fishing_at",
      "comment": "走进喷水池：弹窗确认垂钓，按概率得鱼或空钩",
      "trigger": { "type": "area_enter", "zone": "喷水池", "ai": { "gather": "fish" } },
      "repeat": true,
      "actions": [
        { "type": "run_script", "script": "E10_fishing_at" }
      ]
    },
    {
      "id": "E11_herb_at",
      "comment": "走进农田：弹窗确认采药，按概率得药材或空手",
      "trigger": { "type": "area_enter", "zone": "农田", "ai": { "gather": "herb" } },
      "repeat": true,
      "actions": [
        { "type": "run_script", "script": "E11_herb_at" }
      ]
    },
    {
      "id": "E12_wood_at",
      "comment": "走到木材堆：弹窗确认取木，按概率得松木/沉香/朽木",
      "trigger": { "type": "area_enter", "zone": "木材堆", "ai": { "gather": "wood" } },
      "repeat": true,
      "actions": [
        { "type": "run_script", "script": "E12_wood_at" }
      ]
    },
    {
      "id": "E13_quest_done_advance",
      "comment": "★ 任务完成 → 剧情推进（通用示范）：任何带 flags.done 的委托交付后（q06_done 由任务板交付时写入 player_flags），用 flag_check 串起后续剧情节拍",
      "trigger": { "type": "enter_map" },
      "conditions": [
        { "type": "flag_check", "key": "q06_done", "op": "exists" },
        { "type": "flag_check", "key": "quest_advance_seen", "op": "missing" }
      ],
      "actions": [
        { "type": "toast", "text": "【委托完成】你带回的消息被人认真记下了。", "color": "gold" },
        { "type": "event_log", "text": "委托完成 → 剧情推进" },
        { "type": "set_flag", "key": "quest_advance_seen", "value": true }
      ]
    }
  ]
}