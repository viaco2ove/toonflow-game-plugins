{
  "version": 1,
  "map": "mulberryTown",
  "events": [
    {
      "id": "E01_bind_system",
      "comment": "phase_1 开局：进图自动触发系统绑定过场",
      "trigger": { "type": "enter_map" },
      "conditions": [
        { "type": "flag_check", "key": "phase_1_done", "op": "missing" },
        { "type": "flag_check", "key": "phase_1_active", "op": "missing" }
      ],
      "actions": [
        { "type": "run_script", "script": "E01_bind_system" }
      ]
    },
    {
      "id": "E02_broom_pickup",
      "comment": "phase_1 节拍1「扫帚与石阶」：进入祖师堂区域即拾起扫帚（扫帚是装饰物无实体，故用区域触发）",
      "trigger": { "type": "area_enter", "zone": "祖师堂" },
      "conditions": [
        { "type": "flag_check", "key": "phase_1_active", "value": true },
        { "type": "flag_check", "key": "broom_picked", "op": "missing" }
      ],
      "actions": [
        { "type": "run_script", "script": "E02_broom_pickup" }
      ]
    },
    {
      "id": "E03_xuanchen_bainian",
